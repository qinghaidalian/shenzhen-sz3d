<Window x:Class="Sz3D.Presentation.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nodify="https://miroiu.github.io/nodify"
        xmlns:vm="clr-namespace:Sz3D.Presentation.WPF.ViewModels"
        xmlns:svc="clr-namespace:Sz3D.Presentation.WPF.Services"
        xmlns:avalondock="https://github.com/Dirkster99/AvalonDock"
        xmlns:avalondockTheme="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        xmlns:adctrl="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
        Title="3D Vision"
        Icon="Resources/AppIcon.ico"
        Height="780" Width="1360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBackground}"
        Foreground="{StaticResource PrimaryForeground}">

    <Window.Resources>
        <!-- 已完成连线 -->
        <DataTemplate x:Key="ConnectionTemplate" DataType="{x:Type vm:ConnectionViewModel}">
            <nodify:Connection Source="{Binding Output.Anchor}"
                               Target="{Binding Input.Anchor}"
                               Stroke="{StaticResource AccentColor}"
                               StrokeThickness="2"/>
        </DataTemplate>

        <!-- 拖拽中的连线 -->
        <DataTemplate x:Key="PendingConnectionTemplate" DataType="{x:Type vm:PendingConnectionViewModel}">
            <nodify:PendingConnection IsVisible="{Binding IsVisible}"
                                      Source="{Binding Source, Mode=OneWayToSource}"
                                      Target="{Binding Target, Mode=OneWayToSource}"
                                      TargetAnchor="{Binding TargetLocation, Mode=OneWayToSource}"
                                      Stroke="{StaticResource AccentColor}"
                                      StrokeThickness="2"
                                      StrokeDashArray="4 2"
                                      StartedCommand="{Binding DataContext.StartConnectionCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      CompletedCommand="{Binding DataContext.CreateConnectionCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"/>
        </DataTemplate>

        <!-- 节点容器：位置 + 选中 -->
        <Style x:Key="ItemContainerStyle" TargetType="{x:Type nodify:ItemContainer}"
               BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
            <Setter Property="Location" Value="{Binding Location}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected}"/>
            <!-- 选中高亮用半透明蓝，避免默认白色覆盖导致文字看不清 -->
            <Setter Property="SelectedBrush" Value="#663D9BE9"/>
            <Setter Property="HighlightBrush" Value="#663D9BE9"/>
            <Setter Property="SelectedBorderThickness" Value="2"/>
        </Style>

        <!-- 节点外观（深色 + 强调色标题） -->
        <Style TargetType="{x:Type nodify:Node}">
            <Setter Property="HeaderBrush" Value="#0E639C"/>
            <Setter Property="ContentBrush" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 算子列表项模板（可拖拽） -->
        <DataTemplate DataType="{x:Type svc:OperatorDescriptor}">
            <Border Padding="6 4" Cursor="Hand" Background="Transparent"
                    ToolTip="{Binding Description}"
                    PreviewMouseLeftButtonDown="OnOperatorMouseDown"
                    MouseMove="OnOperatorMouseMove">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{StaticResource PrimaryForeground}"
                               FontSize="12.5" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Category}"
                               Foreground="{StaticResource MutedForeground}"
                               FontSize="10" Margin="8 0 0 0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <!-- 根布局：两行 Grid（钉死，Finding 4）。
         Row0 = 顶部 chrome（Auto），Row1 = DockingManager（*）。
         根 Grid 不设 DataContext，继承 Window 的 MainViewModel（Finding 3）。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════ 顶部 chrome：菜单栏 + 工具栏 + 状态（固定顶部，DockingManager 外部，逐字保留） ══════════ -->
        <DockPanel Grid.Row="0" Background="{StaticResource PrimaryBackground}">
            <Menu DockPanel.Dock="Top" Background="Transparent" Foreground="{StaticResource PrimaryForeground}">
                <MenuItem Header="文件">
                    <MenuItem Header="新建"    Command="{Binding NewCommand}"    InputGestureText="Ctrl+N"/>
                    <MenuItem Header="加载"    Command="{Binding LoadCommand}"   InputGestureText="Ctrl+O"/>
                    <MenuItem Header="最近加载"/>
                    <Separator/>
                    <MenuItem Header="保存"    Command="{Binding SaveCommand}"   InputGestureText="Ctrl+S"/>
                    <MenuItem Header="另存为"  Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                    <Separator/>
                    <MenuItem Header="退出"    Command="{Binding ExitCommand}"   InputGestureText="Ctrl+Q"/>
                </MenuItem>
                <MenuItem Header="资源">
                    <MenuItem Header="重新扫描插件" Click="OnRescanPlugins"/>
                    <Separator/>
                    <MenuItem Header="打开插件目录" Click="OnOpenPluginsDir"/>
                    <MenuItem Header="打开模型目录" Click="OnOpenModelsDir"/>
                    <MenuItem Header="打开自动保存目录" Click="OnOpenAutosaveDir"/>
                    <MenuItem Header="打开日志目录" Click="OnOpenLogsDir"/>
                </MenuItem>
                <MenuItem Header="视图" SubmenuOpened="OnViewMenuOpened">
                    <MenuItem Header="窗口布局一"/>
                    <MenuItem Header="窗口布局二"/>
                    <MenuItem Header="窗口布局三"/>
                    <MenuItem Header="窗口布局四"/>
                    <Separator/>
                    <MenuItem x:Name="MenuPanelGraph"  Header="算子图" IsCheckable="True"
                              Click="OnTogglePanelGraph"/>
                    <MenuItem x:Name="MenuPanelView3D" Header="3D 视图" IsCheckable="True"
                              Click="OnTogglePanelView3D"/>
                    <MenuItem x:Name="MenuPanelView2D" Header="2D 视图" IsCheckable="True"
                              Click="OnTogglePanelView2D"/>
                    <MenuItem x:Name="MenuPanelProps"  Header="属性面板" IsCheckable="True"
                              Click="OnTogglePanelProps"/>
                    <MenuItem x:Name="MenuPanelOpTree" Header="算子树状图" IsCheckable="True"
                              Click="OnTogglePanelOpTree"/>
                    <MenuItem x:Name="MenuPanelOpList" Header="算子列表" IsCheckable="True"
                              Click="OnTogglePanelOpList"/>
                    <MenuItem x:Name="MenuPanelDebug"  Header="调试面板" IsCheckable="True"
                              Click="OnTogglePanelDebug"/>
                </MenuItem>
                <MenuItem Header="运行">
                    <MenuItem Header="运行"     Command="{Binding RunCommand}"/>
                    <MenuItem Header="单次运行" Command="{Binding RunOnceCommand}"/>
                    <MenuItem Header="停止"     Command="{Binding StopCommand}"/>
                </MenuItem>
                <MenuItem Header="设置">
                    <MenuItem Header="语言">
                        <MenuItem Header="简体中文" IsCheckable="True" IsChecked="True"/>
                        <MenuItem Header="English" IsCheckable="True"/>
                    </MenuItem>
                    <MenuItem Header="首选项" Click="OnOpenPreferences"/>
                    <Separator/>
                    <MenuItem Header="恢复默认布局" Click="OnResetLayout"/>
                </MenuItem>
                <MenuItem Header="帮助">
                    <MenuItem Header="帮助文档" Click="OnOpenHelpDoc"/>
                    <MenuItem Header="官方网站" Click="OnOpenWebsite"/>
                    <Separator/>
                    <MenuItem Header="检查更新" Click="OnCheckUpdate"/>
                    <MenuItem Header="关于 3D Vision Suite" Click="OnShowAbout"/>
                </MenuItem>
            </Menu>

            <!-- 工具栏：图标 + 文字，排版与配色参照SZ工具条 -->
            <DockPanel DockPanel.Dock="Bottom" Margin="4 10 4 6">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <!-- 运行 -->
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding RunCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource GeoRun}" Fill="{StaticResource IconRun}"/>
                            <TextBlock Text="运行" Margin="5 0 0 0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- 停止 -->
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding StopCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource GeoStop}" Fill="{StaticResource IconStop}"/>
                            <TextBlock Text="停止" Margin="5 0 0 0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- 单次运行 -->
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding RunOnceCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource GeoStep}" Fill="{StaticResource IconStep}"/>
                            <TextBlock Text="单次运行" Margin="5 0 0 0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Style="{StaticResource ToolbarSeparator}"/>

                    <!-- 状态指示：圆点 + 文本 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2 0">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{StaticResource IconDelete}"/>
                        <TextBlock Text="{Binding StatusText}" Margin="5 0 0 0" VerticalAlignment="Center"
                                   FontSize="13" Foreground="{StaticResource PrimaryForeground}"/>
                    </StackPanel>

                    <Rectangle Style="{StaticResource ToolbarSeparator}"/>

                    <!-- 新建 -->
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding NewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource GeoNew}" Stroke="{StaticResource IconDoc}"
                                  StrokeThickness="1.4" Fill="Transparent"/>
                            <TextBlock Text="新建" Margin="5 0 0 0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- 加载 -->
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding LoadCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource GeoLoad}" Stroke="{StaticResource IconLoad}"
                                  StrokeThickness="1.4" Fill="Transparent"/>
                            <TextBlock Text="加载" Margin="5 0 0 0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- 保存 -->
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource GeoSave}" Stroke="{StaticResource IconSave}"
                                  StrokeThickness="1.4" Fill="Transparent"/>
                            <TextBlock Text="保存" Margin="5 0 0 0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- 另存为 -->
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding SaveAsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource GeoSaveAs}" Stroke="{StaticResource IconSaveAs}"
                                  StrokeThickness="1.4" Fill="Transparent"/>
                            <TextBlock Text="另存为" Margin="5 0 0 0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Style="{StaticResource ToolbarSeparator}"/>

                    <!-- 新建分组 -->
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding Editor.CreateGroupCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource GeoGroup}" Stroke="{StaticResource IconGroup}"
                                  StrokeThickness="1.4" Fill="Transparent"/>
                            <TextBlock Text="新建分组" Margin="5 0 0 0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="状态：" Foreground="{StaticResource MutedForeground}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource PrimaryForeground}"
                               Margin="4 0 8 0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </DockPanel>

        <!-- ══════════ 可停靠区：DockingManager 填满剩余 ══════════ -->
        <avalondock:DockingManager Grid.Row="1" x:Name="DockManager">
            <avalondock:DockingManager.Theme>
                <avalondockTheme:Vs2013DarkTheme/>
            </avalondock:DockingManager.Theme>

            <!-- 面板标题栏三角下拉 / 右键菜单：AvalonDock 使用自有子类 ContextMenuEx / MenuItemEx，
                 隐式 ContextMenu/MenuItem 样式不匹配子类，故在此显式指定深色样式，
                 去掉白色图标栏，与顶部菜单下拉保持一致。 -->
            <avalondock:DockingManager.Resources>
                <Style TargetType="{x:Type adctrl:ContextMenuEx}" BasedOn="{StaticResource DarkContextMenu}"/>
                <Style TargetType="{x:Type adctrl:MenuItemEx}" BasedOn="{StaticResource {x:Type MenuItem}}"/>
            </avalondock:DockingManager.Resources>

            <avalondock:LayoutRoot>
                <!-- 顶层 Vertical：三列工作区（上） + 日志（下），对应今日 Grid 的 row1/row3 -->
                <avalondock:LayoutPanel Orientation="Vertical">

                    <!-- 上部 Horizontal：视图 | 算子图 | 工具箱，对应今日 row1 的三列 -->
                    <avalondock:LayoutPanel Orientation="Horizontal">

                        <!-- 左列：3D/2D 两个独立面板放在同一 pane 内，初始合并为一个 Tab 组
                             （DockMinWidth=180 复刻今日左列 MinWidth）。3D 声明在前、默认选中。 -->
                        <avalondock:LayoutAnchorablePane DockMinWidth="180">
                            <!-- 3D 视图：独立可停靠面板（CanFloat 默认 true，可浮动）；
                                 IsSelected/IsActive 显式初始选中，不依赖 pane 默认选首项 -->
                            <avalondock:LayoutAnchorable Title="3D 视图"
                                                         ContentId="panel.view3d"
                                                         CanClose="False"
                                                         CanHide="True"
                                                         IsSelected="True"
                                                         IsActive="True">
                                <Grid Background="#111214">
                                    <Viewport3D x:Name="CloudViewport">
                                        <Viewport3D.Camera>
                                            <PerspectiveCamera Position="0.5 0.5 2.2" LookDirection="0 0 -1"
                                                               UpDirection="0 1 0" FieldOfView="60"/>
                                        </Viewport3D.Camera>
                                        <ModelVisual3D x:Name="CloudVisual"/>
                                        <ModelVisual3D>
                                            <ModelVisual3D.Content>
                                                <Model3DGroup>
                                                    <AmbientLight Color="#888888"/>
                                                    <DirectionalLight Color="#FFFFFF" Direction="-1 -1 -1"/>
                                                </Model3DGroup>
                                            </ModelVisual3D.Content>
                                        </ModelVisual3D>
                                    </Viewport3D>
                                    <TextBlock Text="无点云输出" Foreground="#707070" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Editor.HasCloudOutput}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </avalondock:LayoutAnchorable>

                            <!-- 2D 视图：独立可停靠面板（CanFloat 默认 true，可浮动） -->
                            <avalondock:LayoutAnchorable Title="2D 视图"
                                                         ContentId="panel.view2d"
                                                         CanClose="False"
                                                         CanHide="True">
                                <Grid Background="#111214">
                                    <Image Source="{Binding Editor.ImageOutput}" Stretch="Uniform"/>
                                    <TextBlock Text="无图像输出" Foreground="#707070" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Editor.HasImageOutput}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </avalondock:LayoutAnchorable>
                        </avalondock:LayoutAnchorablePane>

                        <!-- 中央：算子图改为可停靠面板（与 2D/3D 一致，可拖拽/浮动/隐藏），吃剩余 *，DockMinWidth=300 复刻今日中列 MinWidth -->
                        <avalondock:LayoutAnchorablePane DockMinWidth="300">
                            <avalondock:LayoutAnchorable Title="算子图"
                                                         ContentId="panel.graph"
                                                         CanClose="False"
                                                         CanHide="True">
                                    <!-- 中列：算子图（Nodify 节点画布） -->
                                    <nodify:NodifyEditor x:Name="Editor"
                                                         DataContext="{Binding Editor}"
                                                         ItemsSource="{Binding Items}"
                                                         Connections="{Binding Connections}"
                                                         PendingConnection="{Binding PendingConnection}"
                                                         ConnectionTemplate="{StaticResource ConnectionTemplate}"
                                                         PendingConnectionTemplate="{StaticResource PendingConnectionTemplate}"
                                                         ItemContainerStyle="{StaticResource ItemContainerStyle}"
                                                         ItemsDragStartedCommand="{Binding ItemsDragStartedCommand}"
                                                         ItemsDragCompletedCommand="{Binding ItemsDragCompletedCommand}"
                                                         Background="#222325"
                                                         GridCellSize="15"
                                                         AllowDrop="True"
                                                         Drop="OnDropOperator">
                                        <nodify:NodifyEditor.Resources>
                                            <DataTemplate DataType="{x:Type vm:NodeViewModel}">
                                                <!-- 单击右键弹出菜单，点「删除节点」确认删除 -->
                                                <nodify:Node Header="{Binding Title}"
                                                             Input="{Binding Input}"
                                                             Output="{Binding Output}">
                                                    <nodify:Node.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="删除节点" Command="{Binding DeleteCommand}"/>
                                                        </ContextMenu>
                                                    </nodify:Node.ContextMenu>
                                                </nodify:Node>
                                            </DataTemplate>

                                            <!-- 分组块：Nodify 内置 GroupingNode，ZIndex=-1 自动置于节点之后；
                                                 拖 Header 整体平移成员，单击右键弹菜单删除分组 -->
                                            <DataTemplate DataType="{x:Type vm:GroupViewModel}">
                                                <nodify:GroupingNode Header="{Binding Title}"
                                                                     ActualSize="{Binding Size, Mode=TwoWay}"
                                                                     CanResize="True"
                                                                     MovementMode="Self"
                                                                     HeaderBrush="#0E639C">
                                                    <nodify:GroupingNode.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="删除分组" Command="{Binding DeleteCommand}"/>
                                                        </ContextMenu>
                                                    </nodify:GroupingNode.ContextMenu>
                                                </nodify:GroupingNode>
                                            </DataTemplate>

                                            <!-- 连接点：把 Anchor 回写到 VM，供连线使用 -->
                                            <Style TargetType="{x:Type nodify:NodeInput}" BasedOn="{StaticResource OriginalNodeInputStyle}">
                                                <Setter Property="Header" Value="{Binding Title}"/>
                                                <Setter Property="IsConnected" Value="{Binding IsConnected}"/>
                                                <Setter Property="Anchor" Value="{Binding Anchor, Mode=OneWayToSource}"/>
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}"/>
                                            </Style>
                                            <Style TargetType="{x:Type nodify:NodeOutput}" BasedOn="{StaticResource OriginalNodeOutputStyle}">
                                                <Setter Property="Header" Value="{Binding Title}"/>
                                                <Setter Property="IsConnected" Value="{Binding IsConnected}"/>
                                                <Setter Property="Anchor" Value="{Binding Anchor, Mode=OneWayToSource}"/>
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}"/>
                                            </Style>
                                        </nodify:NodifyEditor.Resources>

                                        <nodify:NodifyEditor.InputBindings>
                                            <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}"/>
                                        </nodify:NodifyEditor.InputBindings>
                                    </nodify:NodifyEditor>
                            </avalondock:LayoutAnchorable>
                        </avalondock:LayoutAnchorablePane>

                        <!-- 右列：工具箱四面板（固定宽 300，DockMinWidth=240 复刻今日右列 MinWidth）。
                             四个独立 LayoutAnchorable 放在同一 pane 内，初始合并为一个 Tab 组
                             （与左列 3D/2D 同一机制）；各自可用 X 关闭（实为隐藏，保留在布局树中），
                             并能从「视图」菜单逐个重新勾选显示。属性面板声明在前、默认选中。 -->
                        <avalondock:LayoutAnchorablePane DockWidth="300" DockMinWidth="240">
                            <!-- 属性面板：选中节点后显示可编辑参数 -->
                            <avalondock:LayoutAnchorable Title="属性面板"
                                                         ContentId="panel.props"
                                                         CanClose="False"
                                                         CanHide="True"
                                                         IsSelected="True"
                                                         IsActive="True">
                                        <Grid>
                                            <TextBlock Text="选中节点后显示可编辑参数" Foreground="{StaticResource MutedForeground}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Editor.SelectedNode}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel DataContext="{Binding Editor.SelectedNode}" Margin="10">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"
                                                               Foreground="{StaticResource PrimaryForeground}" Margin="0 0 0 10"/>
                                                    <ItemsControl ItemsSource="{Binding Parameters}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:ParameterViewModel}">
                                                                <Grid Margin="0 3">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" MinWidth="70"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                                               Foreground="{StaticResource PrimaryForeground}"
                                                                               Margin="0 0 8 0" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBox Grid.Column="1" Text="{Binding Text}"
                                                                             VerticalAlignment="Center"
                                                                             HorizontalAlignment="Stretch">
                                                                        <TextBox.Style>
                                                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsBool}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBox.Style>
                                                                    </TextBox>
                                                                    <CheckBox Grid.Column="1" IsChecked="{Binding BoolValue}"
                                                                              VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                              Foreground="{StaticResource PrimaryForeground}">
                                                                        <CheckBox.Style>
                                                                            <Style TargetType="CheckBox">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsBool}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </CheckBox.Style>
                                                                    </CheckBox>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                            </avalondock:LayoutAnchorable>

                            <!-- 算子树状图：占位 -->
                            <avalondock:LayoutAnchorable Title="算子树状图"
                                                         ContentId="panel.optree"
                                                         CanClose="False"
                                                         CanHide="True">
                                        <TextBlock Text="算子树（占位）" Foreground="{StaticResource MutedForeground}" Margin="12"/>
                            </avalondock:LayoutAnchorable>

                            <!-- 算子列表：可拖拽到画布的算子分组列表 -->
                            <avalondock:LayoutAnchorable Title="算子列表"
                                                         ContentId="panel.oplist"
                                                         CanClose="False"
                                                         CanHide="True">
                                        <DockPanel Margin="6">
                                            <DockPanel DockPanel.Dock="Top" Margin="0 0 0 6">
                                                <Button DockPanel.Dock="Right" Content="更新" Margin="6 0 0 0"/>
                                                <TextBox Text="查找算子…" Foreground="{StaticResource MutedForeground}"/>
                                            </DockPanel>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding OperatorGroups}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Expander Header="{Binding Title}" IsExpanded="True" Margin="0 2">
                                                                <ItemsControl ItemsSource="{Binding Items}"/>
                                                            </Expander>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                            </avalondock:LayoutAnchorable>

                            <!-- 调试面板：占位 -->
                            <avalondock:LayoutAnchorable Title="调试面板"
                                                         ContentId="panel.debug"
                                                         CanClose="False"
                                                         CanHide="True">
                                        <TextBlock Text="调试面板（占位）" Foreground="{StaticResource MutedForeground}" Margin="12"/>
                            </avalondock:LayoutAnchorable>
                        </avalondock:LayoutAnchorablePane>
                    </avalondock:LayoutPanel>

                    <!-- 底部：日志（固定高 150，DockMinHeight=60 复刻今日日志 Row MinHeight） -->
                    <avalondock:LayoutAnchorablePane DockHeight="150" DockMinHeight="60">
                        <avalondock:LayoutAnchorable Title="日志"
                                                     ContentId="panel.log"
                                                     CanClose="False"
                                                     CanHide="True">
                            <!-- 底部：日志视图 -->
                            <DataGrid ItemsSource="{Binding Logs}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间戳"    Binding="{Binding Timestamp}" Width="190"/>
                                    <DataGridTextColumn Header="通道"      Binding="{Binding Channel}"   Width="130"/>
                                    <DataGridTextColumn Header="安全级别"  Binding="{Binding Level}"     Width="80"/>
                                    <DataGridTextColumn Header="消息"      Binding="{Binding Message}"   Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </avalondock:LayoutAnchorable>
                    </avalondock:LayoutAnchorablePane>
                </avalondock:LayoutPanel>
            </avalondock:LayoutRoot>
        </avalondock:DockingManager>
    </Grid>
</Window>
