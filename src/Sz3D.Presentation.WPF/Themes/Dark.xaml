<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── 颜色 ── -->
    <SolidColorBrush x:Key="PrimaryBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PrimaryForeground" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="AccentColor"       Color="#007ACC"/>
    <SolidColorBrush x:Key="PanelBackground"   Color="#252526"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#2D2D30"/>
    <SolidColorBrush x:Key="ControlHover"      Color="#3E3E42"/>
    <SolidColorBrush x:Key="BorderColor"       Color="#3F3F46"/>
    <SolidColorBrush x:Key="MutedForeground"   Color="#9A9A9A"/>
    <SolidColorBrush x:Key="HeaderBackground"  Color="#2A2D2E"/>

    <!-- ── 按钮 ── -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8 3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ControlHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── 文本框 ── -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="CaretBrush" Value="{StaticResource PrimaryForeground}"/>
        <Setter Property="Padding" Value="3 2"/>
    </Style>

    <!-- ── 菜单 / 右键菜单 ── -->
    <!-- 顶层菜单栏容器 -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource PrimaryBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}"/>
    </Style>

    <!-- 菜单项：自定义模板，确保下拉弹层为深色背景、文字清晰可读 -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8 4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="20" SharedSizeGroup="Icon"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 图标 / 勾选占位 -->
                            <ContentPresenter x:Name="Icon" Grid.Column="0"
                                              ContentSource="Icon"
                                              Margin="4 0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>

                            <!-- 可勾选项的勾选标记（IsChecked=True 时显示，仿图漾视图菜单） -->
                            <Path x:Name="CheckMark" Grid.Column="0"
                                  Width="12" Height="12"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Stretch="Uniform"
                                  Data="M 0 5 L 4 9 L 11 1"
                                  Stroke="{StaticResource AccentColor}"
                                  StrokeThickness="2"
                                  Visibility="Collapsed"/>

                            <!-- 标题 -->
                            <ContentPresenter Grid.Column="1"
                                              ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <!-- 快捷键文本 -->
                            <TextBlock Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Margin="12 0 8 0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedForeground}"/>

                            <!-- 子菜单展开箭头 -->
                            <Path x:Name="Arrow" Grid.Column="3"
                                  Margin="0 0 8 0"
                                  VerticalAlignment="Center"
                                  Data="M 0 0 L 4 4 L 0 8 Z"
                                  Fill="{StaticResource PrimaryForeground}"
                                  Visibility="Collapsed"/>

                            <!-- 下拉弹层：深色背景 + 边框 -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource ControlBackground}"
                                        BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="1"
                                        Padding="2">
                                    <ScrollViewer>
                                        <ItemsPresenter Grid.IsSharedSizeScope="True"
                                                        SnapsToDevicePixels="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 顶层菜单项（菜单栏上的「文件」「运行」等） -->
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <!-- 子菜单弹层中的项，箭头朝右、弹层向右展开 -->
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                        </Trigger>
                        <!-- 悬停高亮 -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentColor}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <!-- 已勾选：显示勾选标记 -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- 高亮时勾选标记转白，贴合高亮底色 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsHighlighted" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckMark" Property="Stroke" Value="#FFFFFF"/>
                        </MultiTrigger>
                        <!-- 禁用项：灰显但仍可辨识 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#6E6E6E"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 菜单内的分隔线 -->
    <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
        <Setter Property="Background" Value="{StaticResource BorderColor}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="4 2"/>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
    </Style>

    <!-- ── TabControl / TabItem ── -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}"/>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="Padding" Value="10 4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1 1 1 0"
                            Margin="0 0 2 0"
                            CornerRadius="3 3 0 0">
                        <ContentPresenter x:Name="Content"
                                          ContentSource="Header"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="12.5"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 选中：强调色背景 + 白字 -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentColor}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <!-- 悬停：浅一点的灰 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHover}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── GridSplitter（面板伸缩分隔条，仿 RVS） ── -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource BorderColor}"/>
        <Setter Property="ShowsPreview" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── 折叠面板（算子分组标题） ── -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}"/>
    </Style>

    <!-- ── 提示 ── -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
    </Style>

    <!-- ── 日志表格 ── -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="RowBackground" Value="{StaticResource PanelBackground}"/>
        <Setter Property="AlternatingRowBackground" Value="#232325"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#333337"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource HeaderBackground}"/>
                    <Setter Property="Foreground" Value="#E8E8E8"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8 4"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                    <Setter Property="BorderThickness" Value="0 0 1 1"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="8 2"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

