<Application x:Class="Sz3D.Presentation.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodify="https://miroiu.github.io/nodify"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Nodify 默认连接点样式：先以键捕获，供编辑器内隐式样式 BasedOn，避免自引用 -->
            <Style x:Key="OriginalNodeInputStyle" TargetType="{x:Type nodify:NodeInput}"
                   BasedOn="{StaticResource {x:Type nodify:NodeInput}}"/>
            <Style x:Key="OriginalNodeOutputStyle" TargetType="{x:Type nodify:NodeOutput}"
                   BasedOn="{StaticResource {x:Type nodify:NodeOutput}}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
