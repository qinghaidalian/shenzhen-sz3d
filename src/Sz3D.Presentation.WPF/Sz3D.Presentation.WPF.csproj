<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sz3D.Core.Infrastructure\Sz3D.Core.Infrastructure.csproj" />
    <ProjectReference Include="..\Sz3D.Core.Operators\Sz3D.Core.Operators.csproj" />
    <ProjectReference Include="..\Sz3D.Plugins.Algorithms\Sz3D.Plugins.Algorithms.csproj" />
    <ProjectReference Include="..\Sz3D.Plugins.Cameras\Sz3D.Plugins.Cameras.csproj" />
    <ProjectReference Include="..\Sz3D.Plugins.Robots\Sz3D.Plugins.Robots.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" Version="5.0.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="5.0.1" />
    <PackageReference Include="Nodify" Version="7.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 应用程序（.exe / 任务栏）图标 -->
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 窗口图标资源：随程序集打包，供 Window.Icon 引用 -->
    <Resource Include="Resources\AppIcon.ico" />
    <Resource Include="Resources\AppIcon.png" />
  </ItemGroup>

</Project>

